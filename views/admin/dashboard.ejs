                { section: 'Workflow Steps', key: 'video-step-1', label: 'Step 1 Title', type: 'text', limit: 30 },
                { section: 'Workflow Steps', key: 'video-step-2', label: 'Step 2 Title', type: 'text', limit: 30 },
