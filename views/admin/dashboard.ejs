                { section: 'Content', key: 'social-sub-headline', label: 'Sub-Section: Headline', type: 'text', limit: 50 },
                { section: 'Content', key: 'social-sub-intro', label: 'Sub-Section: Intro', type: 'textarea', limit: 300 },
                { section: 'Visuals', key: 'social-main-img', label: 'Main Page Image URL', type: 'text' },
