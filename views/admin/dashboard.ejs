        function updateContactPreview(key, type) {
            const input = document.getElementById('input-' + key);
            if (!input) return;
            const val = input.value.trim();
            const previewVal = document.getElementById('preview-val-' + key);
            const previewLink = document.getElementById('preview-link-' + key);
            if (!previewVal || !previewLink) return;

            if (type === 'wa') {
                const digits = val.replace(/\D/g, '') || '918086180780';
                previewVal.innerText = digits;
                previewLink.href = 'https://wa.me/' + digits;
            } else if (type === 'tel') {
                const tel = val.replace(/[^\d+]/g, '');
                previewVal.innerText = tel;
                previewLink.href = 'tel:' + tel;
            } else {
                previewVal.innerText = val;
                previewLink.href = 'mailto:' + val;
            }
        }

        async function saveAllContactNumbers() {
            const btn = document.getElementById('saveAllContactsBtn');
            const originalHtml = btn ? btn.innerHTML : '';
            if (btn) {
                btn.innerHTML = '<span class="animate-spin material-symbols-outlined text-sm">sync</span> SAVING...';
                btn.disabled = true;
            }

            const keys = [
                'contact-whatsapp',
                'contact-primary-phone',
                'contact-footer-phone-1',
                'contact-footer-phone-2',
                'contact-email'
            ];

            const payload = {};
            keys.forEach(k => {
                const el = document.getElementById('input-' + k);
                if (el) payload[k] = el.value.trim();
            });

            try {
                const res = await fetch('/api/contact-numbers', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (data.success) {
                    showToast('All contact numbers updated and synced across all pages!');
                    if (btn) {
                        btn.innerHTML = '<span class="material-symbols-outlined text-sm">done</span> ALL SAVED!';
                        setTimeout(() => {
                            btn.innerHTML = originalHtml;
                            btn.disabled = false;
                        }, 2000);
                    }
                } else {
                    alert('Error saving contact numbers: ' + (data.error || 'Unknown error'));
                    if (btn) {
                        btn.innerHTML = originalHtml;
                        btn.disabled = false;
                    }
                }
            } catch (err) {
                console.error(err);
                alert('Network error while saving contact numbers.');
                if (btn) {
                    btn.innerHTML = originalHtml;
                    btn.disabled = false;
                }
            }
        }

        function renderFields() {
            const grid = document.getElementById('contentGrid');
            grid.innerHTML = '';
            
            if (currentPage === 'contact-numbers' || currentPage === 'contact') {
                renderContactNumbersView(grid, pageContents);
                return;
            }
            
            const fields = pageSchema[currentPage] || [];
            
            if (fields.length === 0) {
                grid.innerHTML = '<div class="text-center py-20 border-2 border-dashed border-black/5 rounded-[40px] text-gray-400">Select a page from the sidebar to manage its content.</div>';
                return;
            }

            let currentSection = '';
            let sectionContainer = null;

            fields.forEach(field => {
                if (field.section !== currentSection) {
                    currentSection = field.section;
                    const sectionHeader = document.createElement('div');
                    sectionHeader.className = 'col-span-full pt-8 pb-4';
                    sectionHeader.innerHTML = `<h3 class="text-xs font-black uppercase tracking-[0.3em] text-gray-400">${currentSection}</h3>`;
                    grid.appendChild(sectionHeader);
                    
                    if (currentSection === 'Service Cards') {
                        sectionContainer = document.createElement('div');
                        sectionContainer.className = 'grid grid-cols-1 md:grid-cols-2 gap-6 col-span-full';
                        grid.appendChild(sectionContainer);
                    } else {
                        sectionContainer = grid;
                    }
                }

                const value = pageContents[field.key] || '';
                const card = document.createElement('div');
                card.className = 'glass rounded-[32px] p-8 space-y-4 hover:shadow-lg transition-all duration-500 bg-white';
                
                const limit = field.limit || 500;
                let inputHtml = '';
                
                if (field.type === 'textarea') {
                    inputHtml = `<textarea id="input-${field.key}" maxlength="${limit}" oninput="updateCounter('${field.key}', ${limit})" class="w-full bg-transparent border border-black/5 rounded-2xl p-4 text-sm focus:outline-none focus:border-black/20 min-h-[120px]" placeholder="Enter ${field.label}...">${value}</textarea>`;
                } else if (field.type === 'select') {
                    const optionsHtml = field.options.map(opt => `<option value="${opt}" ${value === opt ? 'selected' : ''}>${opt.toUpperCase()}</option>`).join('');
                    inputHtml = `<select id="input-${field.key}" class="w-full bg-transparent border border-black/5 rounded-2xl p-4 text-sm focus:outline-none focus:border-black/20 cursor-pointer appearance-none">
                        ${optionsHtml}
                    </select>`;
                } else {
                    inputHtml = `<input type="text" id="input-${field.key}" maxlength="${limit}" oninput="updateCounter('${field.key}', ${limit})" value="${value}" class="w-full bg-transparent border border-black/5 rounded-2xl p-4 text-sm focus:outline-none focus:border-black/20" placeholder="Enter ${field.label}...">`;
                }

                card.innerHTML = `
                    <div class="flex justify-between items-start">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full bg-gray-50 flex items-center justify-center">
                                <span class="material-symbols-outlined text-gray-400 text-lg">edit_note</span>
                            </div>
                            <div>
                                <h4 class="font-bold text-sm text-gray-900">${field.label}</h4>
                                <div class="flex items-center gap-2">
                                    <span class="text-[9px] font-mono text-gray-400 uppercase tracking-widest">${field.key}</span>
                                    ${field.type !== 'select' ? `<span id="counter-${field.key}" class="text-[9px] font-bold text-gray-300 uppercase tracking-widest">${value.length}/${limit}</span>` : ''}
                                </div>
                            </div>
                        </div>
                        <button onclick="saveField('${field.key}')" id="btn-save-${field.key}" class="group flex items-center gap-2 text-xs font-black bg-black text-white px-5 py-2.5 rounded-full hover:scale-105 transition-all">
                            <span>SAVE</span>
                            <span class="material-symbols-outlined text-sm group-hover:translate-x-1 transition-transform">arrow_forward</span>
                        </button>
                    </div>
                    <div class="pt-2">
                        ${inputHtml}
                    </div>
                `;
                sectionContainer.appendChild(card);
            });
            
            if (currentPage === 'blog') {
                loadDynamicArticles(grid);
            }
        }

        function updateCounter(key, limit) {
            const val = document.getElementById('input-' + key).value;
            const counter = document.getElementById('counter-' + key);
            counter.innerText = val.length + '/' + limit;
            if (val.length >= limit) {
                counter.classList.add('text-red-500');
            } else {
                counter.classList.remove('text-red-500');
            }
        }

        async function saveField(key) {
            const value = document.getElementById('input-' + key).value;
            const btn = document.getElementById('btn-save-' + key);
            const originalText = btn.innerHTML;
            
            btn.innerHTML = '<span class="animate-spin material-symbols-outlined">sync</span>';
            btn.disabled = true;
            
            try {
                const response = await fetch('/api/content', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ page: currentPage, key, value })
                });
                
                const result = await response.json();
                if (result.success) {
                    showToast('Field "' + key + '" updated successfully');
                    btn.innerHTML = '<span class="material-symbols-outlined">done</span> SAVED';
                    setTimeout(() => {
                        btn.innerHTML = originalText;
                        btn.disabled = false;
                    }, 2000);
                } else {
                    alert('Error: ' + result.error);
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                }
            } catch (err) {
                console.error(err);
                alert('Failed to save.');
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
        }

        function showToast(message) {
            const toast = document.getElementById('toast');
            document.getElementById('toastMessage').innerText = message;
            toast.classList.remove('translate-y-20', 'opacity-0');
            
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }

        async function loadDynamicArticles(grid) {
            const sectionHeader = document.createElement('div');
            sectionHeader.className = 'col-span-full pt-12 pb-4 flex justify-between items-end';
            sectionHeader.innerHTML = `
                <h3 class="text-xs font-black uppercase tracking-[0.3em] text-gray-400">PUBLISHED ARTICLES</h3>
            `;
            grid.appendChild(sectionHeader);

            const articlesContainer = document.createElement('div');
            articlesContainer.className = 'grid grid-cols-1 md:grid-cols-2 gap-6 col-span-full';
            articlesContainer.id = 'articlesContainer';
            grid.appendChild(articlesContainer);

            try {
                const response = await fetch('/api/articles');
                loadedArticles = await response.json();
                
                if (loadedArticles.length === 0) {
                    articlesContainer.innerHTML = '<p class="text-gray-400 text-sm col-span-full">No articles published yet.</p>';
                } else {
                    loadedArticles.forEach(article => {
                        const card = document.createElement('div');
                        const isFeatured = article.isFeatured;
                        card.className = `glass rounded-[32px] p-6 space-y-4 bg-white hover:shadow-lg transition-all relative ${isFeatured ? 'border-2 border-black' : ''}`;
                        card.innerHTML = `
                            <div class="absolute top-6 right-6 flex items-center gap-2">
                                <button onclick="featureArticle('${article._id}')" class="text-gray-400 hover:text-yellow-500 transition-colors" title="Mark as Featured">
                                    <span class="material-symbols-outlined ${isFeatured ? 'text-yellow-500' : ''}">${isFeatured ? 'star' : 'star_border'}</span>
                                </button>
                                <button onclick="openArticleModal('${article._id}')" class="text-blue-500 hover:text-blue-700 transition-colors" title="Edit Article">
                                    <span class="material-symbols-outlined">edit</span>
                                </button>
                                <button onclick="deleteArticle('${article._id}')" class="text-red-500 hover:text-red-700 transition-colors" title="Delete">
                                    <span class="material-symbols-outlined">delete</span>
                                </button>
                            </div>
                            <span class="text-[9px] font-bold text-black uppercase tracking-widest bg-gray-100 px-3 py-1 rounded-full">${article.category}</span>
                            <h4 class="font-bold text-lg leading-tight pr-24">${article.title}</h4>
                            <p class="text-xs text-gray-500 line-clamp-2">${article.summary}</p>
                            <img src="${article.imageUrl}" alt="" class="w-full h-32 object-cover rounded-xl mt-4">
                        `;
                        articlesContainer.appendChild(card);
                    });
                }
            } catch (err) {
                console.error(err);
            }
        }

        async function featureArticle(id) {
            try {
                const response = await fetch('/api/articles/' + id + '/feature', { method: 'PUT' });
                const result = await response.json();
                if (result.success) {
                    showToast('Article marked as featured');
                    renderFields(); // Re-render to refresh list
                }
            } catch (err) {
                console.error(err);
            }
        }

        async function deleteArticle(id) {
            if (!confirm('Are you sure you want to delete this article?')) return;
            try {
                const response = await fetch('/api/articles/' + id, { method: 'DELETE' });
                const result = await response.json();
                if (result.success) {
                    showToast('Article deleted');
                    renderFields(); // Re-render to refresh list
                }
            } catch (err) {
                console.error(err);
            }
        }

        function openArticleModal(articleId = null) {
            const modalTitle = document.getElementById('articleModalTitle');
            const submitBtn = document.getElementById('btnPublishArticle');

            if (articleId) {
                editingArticleId = articleId;
                const article = loadedArticles.find(a => a._id === articleId);
                if (article) {
                    if (modalTitle) modalTitle.innerText = 'Edit Article';
                    if (submitBtn) submitBtn.innerText = 'SAVE CHANGES';
                    
                    document.getElementById('art-category').value = article.category;
                    document.getElementById('art-img').value = article.imageUrl;
                    document.getElementById('art-title').value = article.title;
                    document.getElementById('art-summary').value = article.summary;
                    document.getElementById('art-description').value = article.description || '';
                    document.getElementById('art-meta-title').value = article.metaTitle || '';
                    document.getElementById('art-meta-description').value = article.metaDescription || '';
                    document.getElementById('art-focus-keyword').value = article.focusKeyword || '';
                }
            } else {
                editingArticleId = null;
                if (modalTitle) modalTitle.innerText = 'Publish Article';
                if (submitBtn) submitBtn.innerText = 'PUBLISH';
                document.getElementById('newArticleForm').reset();
                document.getElementById('art-meta-title').value = '';
                document.getElementById('art-meta-description').value = '';
                document.getElementById('art-focus-keyword').value = '';
            }

            document.getElementById('articleModal').classList.remove('hidden');
            document.getElementById('articleModal').classList.add('flex');
        }

        function closeArticleModal() {
            document.getElementById('articleModal').classList.add('hidden');
            document.getElementById('articleModal').classList.remove('flex');
            document.getElementById('newArticleForm').reset();
            document.getElementById('art-meta-title').value = '';
            document.getElementById('art-meta-description').value = '';
            document.getElementById('art-focus-keyword').value = '';
            editingArticleId = null;

            const container = document.getElementById('linking-suggestions-container');
            if (container) {
                container.classList.add('hidden');
                document.getElementById('linking-suggestions-list').innerHTML = '';
            }
        }

        async function publishArticle(e) {
            e.preventDefault();
            const btn = document.getElementById('btnPublishArticle');
            const isEditing = !!editingArticleId;
            btn.innerHTML = isEditing ? 'SAVING...' : 'PUBLISHING...';
            btn.disabled = true;

            const data = {
                title: document.getElementById('art-title').value,
                summary: document.getElementById('art-summary').value,
                description: document.getElementById('art-description').value,
                category: document.getElementById('art-category').value,
                imageUrl: document.getElementById('art-img').value,
                metaTitle: document.getElementById('art-meta-title').value,
                metaDescription: document.getElementById('art-meta-description').value,
                focusKeyword: document.getElementById('art-focus-keyword').value
            };

            try {
                const url = isEditing ? `/api/articles/${editingArticleId}` : '/api/articles';
                const method = isEditing ? 'PUT' : 'POST';

                const response = await fetch(url, {
                    method: method,
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const result = await response.json();
                if (result.success) {
                    showToast(isEditing ? 'Article updated' : 'Article published');
                    closeArticleModal();
                    renderFields();
                } else {
                    alert('Error: ' + result.error);
                }
            } catch (err) {
                console.error(err);
            } finally {
                btn.innerHTML = isEditing ? 'SAVE CHANGES' : 'PUBLISH';
                btn.disabled = false;
            }
        }

        const STATIC_LINKS = [
            { phrases: ["contact us", "get in touch", "say hello", "contact page"], url: "/contact", label: "Contact Page" },
            { phrases: ["whatsapp", "chat with us", "message us"], url: "https://wa.me/918086180780", label: "WhatsApp Chat" },
            { phrases: ["home page", "creashift ads", "creashift"], url: "/", label: "Home" },
            { phrases: ["seo management", "seo services", "seo strategy", "search engine optimization", "search ranking", "geo", "generative engine optimization", "seo"], url: "/service-seo", label: "SEO Service" },
            { phrases: ["social media marketing", "social media management", "instagram marketing", "facebook marketing", "social media branding", "social media"], url: "/service-social", label: "Social Media Service" },
            { phrases: ["web development", "website development", "website design", "web design", "web engineering", "website"], url: "/service-web", label: "Web Service" },
            { phrases: ["paid advertising", "google ads", "meta ads", "paid ads", "ad campaigns", "advertising"], url: "/service-ads", label: "Ads Service" },
            { phrases: ["brand identity", "logo design", "graphic design", "brand design", "identity branding"], url: "/service-design", label: "Design Service" },
            { phrases: ["video production", "reels production", "video shoot", "cinematic video", "cinematic shoot"], url: "/service-video", label: "Video Service" }
        ];

        function escapeRegExp(string) {
            return string.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        }

        function scanInternalLinks() {
            const textarea = document.getElementById('art-description');
            const container = document.getElementById('linking-suggestions-container');
            const list = document.getElementById('linking-suggestions-list');
            const headerText = document.getElementById('suggestions-header-text');

            if (!textarea || !container || !list) return;

            const text = textarea.value;
            if (!text.trim()) {
                container.classList.remove('hidden');
                headerText.innerText = "No content to scan";
                list.innerHTML = `<p class="text-[11px] text-gray-500 italic">Please write some article content first.</p>`;
                return;
            }

            // Build rules
            const allRules = [...STATIC_LINKS];

            if (typeof loadedArticles !== 'undefined' && Array.isArray(loadedArticles)) {
                loadedArticles.forEach(article => {
                    if (editingArticleId && article._id === editingArticleId) return;

                    const url = `/blog/${article.slug}`;
                    const phrases = [];
                    if (article.title) {
                        phrases.push(article.title.toLowerCase());
                        const shortTitle = article.title.split('|')[0].trim().toLowerCase();
                        if (shortTitle && shortTitle !== article.title.toLowerCase()) {
                            phrases.push(shortTitle);
                        }
                    }
                    if (article.focusKeyword) {
                        phrases.push(article.focusKeyword.toLowerCase());
                    }
                    if (phrases.length > 0) {
                        allRules.push({
                            phrases: Array.from(new Set(phrases)),
                            url: url,
                            label: `Blog: "${article.title.split('|')[0].trim()}"`
                        });
                    }
                });
            }

            // Parse HTML structure using a temporary div to avoid matching inside attributes/tags
            const tempDiv = document.createElement('div');
            tempDiv.innerHTML = text;

            const opportunities = [];

            // Flatten all rule phrases and sort them by length descending
            const flatPhrases = [];
            allRules.forEach(rule => {
                rule.phrases.forEach(phrase => {
                    flatPhrases.push({
                        phrase: phrase,
                        url: rule.url,
                        label: rule.label
                    });
                });
            });
            flatPhrases.sort((a, b) => b.phrase.length - a.phrase.length);

            // Recursive walker
            function walk(node) {
                if (node.nodeType === Node.ELEMENT_NODE) {
                    if (node.tagName.toLowerCase() === 'a') return; // skip text inside links
                    for (let child of node.childNodes) {
                        walk(child);
                    }
                } else if (node.nodeType === Node.TEXT_NODE) {
                    const content = node.nodeValue;
                    const matchedRanges = []; // track matched ranges to prevent shorter overlaps

                    flatPhrases.forEach(item => {
                        const regex = new RegExp('\\b' + escapeRegExp(item.phrase) + '\\b', 'gi');
                        let match;
                        while ((match = regex.exec(content)) !== null) {
                            const start = match.index;
                            const end = start + match[0].length;

                            // Check overlap with previously matched longer phrases
                            const overlaps = matchedRanges.some(r => (start >= r.start && start < r.end) || (end > r.start && end <= r.end));
                            if (!overlaps) {
                                opportunities.push({
                                    phrase: match[0],
                                    matchedPhrase: item.phrase,
                                    url: item.url,
                                    label: item.label
                                });
                                matchedRanges.push({ start, end });
                            }
                        }
                    });
                }
            }

            walk(tempDiv);

            // Deduplicate opportunities by matchedPhrase (only suggest linking a phrase once)
            const uniqueOpportunities = [];
            const seenPhrases = new Set();
            opportunities.forEach(opp => {
                const key = opp.matchedPhrase.toLowerCase() + '::' + opp.url;
                if (!seenPhrases.has(key)) {
                    seenPhrases.add(key);
                    uniqueOpportunities.push(opp);
                }
            });

            list.innerHTML = '';
            container.classList.remove('hidden');

            if (uniqueOpportunities.length === 0) {
                headerText.innerText = "Suggested Links";
                list.innerHTML = `<p class="text-[11px] text-gray-500 italic">No new linking opportunities found.</p>`;
                return;
            }

            headerText.innerText = "Suggested Links";
            uniqueOpportunities.forEach(opp => {
                const chip = document.createElement('button');
                chip.type = 'button';
                const escapedPhrase = opp.phrase.replace(/"/g, '&quot;');
                const escapedUrl = opp.url.replace(/"/g, '&quot;');
                
                chip.className = 'flex items-center gap-1.5 bg-black/5 hover:bg-black/10 px-2.5 py-1.5 rounded-lg text-[10px] md:text-xs font-semibold transition-all text-black/70 border border-black/5 active:scale-95';
                chip.onclick = () => applyInternalLink(opp.phrase, opp.url);
                chip.innerHTML = `
                    <span class="material-symbols-outlined text-xs md:text-sm text-gray-400 font-normal">link</span>
                    Link "${escapedPhrase}" to ${opp.label}
                `;
                list.appendChild(chip);
            });
        }

        function applyInternalLink(phrase, url) {
            const textarea = document.getElementById('art-description');
            if (!textarea) return;

            const text = textarea.value;
            const tempDiv = document.createElement('div');
            tempDiv.innerHTML = text;

            let applied = false;

            function walkAndReplace(node) {
                if (node.nodeType === Node.ELEMENT_NODE) {
                    if (node.tagName.toLowerCase() === 'a') return;
                    for (let child of Array.from(node.childNodes)) {
                        walkAndReplace(child);
                        if (applied) break;
                    }
                } else if (node.nodeType === Node.TEXT_NODE) {
                    const content = node.nodeValue;
                    const regex = new RegExp('\\b' + escapeRegExp(phrase) + '\\b', 'i');
                    const match = regex.exec(content);

                    if (match) {
                        const beforeText = content.substring(0, match.index);
                        const afterText = content.substring(match.index + match[0].length);

                        const anchor = document.createElement('a');
                        anchor.href = url;
                        anchor.textContent = match[0];

                        const parent = node.parentNode;
                        if (beforeText) {
                            parent.insertBefore(document.createTextNode(beforeText), node);
                        }
                        parent.insertBefore(anchor, node);
                        if (afterText) {
                            parent.insertBefore(document.createTextNode(afterText), node);
                        }
                        parent.removeChild(node);
                        applied = true;
                    }
                }
            }

            walkAndReplace(tempDiv);

            if (applied) {
                textarea.value = tempDiv.innerHTML;
                scanInternalLinks();
            }
        }


        // Initial Load
        selectPage('services');
    </script>
