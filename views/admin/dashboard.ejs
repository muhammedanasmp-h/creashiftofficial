<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="preload" href="/fonts/dm-sans-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/material-symbols-outlined.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="/css/main.min.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>Dashboard | CREASHIFT Admin</title>
    
    
    
    <style>
        body { font-family: 'Inter', sans-serif; }
        .glass { background: rgba(255, 255, 255, 0.7); backdrop-filter: blur(20px); border: 1px solid rgba(0,0,0,0.05); }
        .sidebar-item.active { background: black; color: white; }
    </style>
</head>
<body class="bg-[#fcf8fb] text-[#1b1b1d] min-h-screen flex">
    <!-- Sidebar -->
    <aside class="w-72 border-r border-black/5 p-8 flex flex-col h-screen sticky top-0 bg-white">
        <div class="mb-12">
            <h1 class="text-xl font-black tracking-tighter">CREASHIFT</h1>
            <p class="text-[10px] text-gray-400 uppercase tracking-widest mt-1">Admin Dashboard</p>
        </div>
        
        <nav class="flex-grow space-y-2 overflow-y-auto pb-4 pr-2">
            <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-4">Pages</p>
            <button onclick="selectPage('services')" class="sidebar-item w-full text-left px-4 py-3 rounded-xl text-sm font-medium transition-all hover:bg-gray-100 flex items-center justify-between group active" id="btn-services">
                Services
                <span class="material-symbols-outlined text-lg opacity-0 group-hover:opacity-100 transition-opacity">chevron_right</span>
            </button>
            <button onclick="selectPage('portfolio')" class="sidebar-item w-full text-left px-4 py-3 rounded-xl text-sm font-medium transition-all hover:bg-gray-100 flex items-center justify-between group" id="btn-portfolio">
                Portfolio
                <span class="material-symbols-outlined text-lg opacity-0 group-hover:opacity-100 transition-opacity">chevron_right</span>
            </button>
            <button onclick="selectPage('blog')" class="sidebar-item w-full text-left px-4 py-3 rounded-xl text-sm font-medium transition-all hover:bg-gray-100 flex items-center justify-between group" id="btn-blog">
                Blog / Editorial
                <span class="material-symbols-outlined text-lg opacity-0 group-hover:opacity-100 transition-opacity">chevron_right</span>
            </button>
            <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest pt-6 mb-4">Communication & Settings</p>
            <button onclick="selectPage('contact-numbers')" class="sidebar-item w-full text-left px-4 py-3 rounded-xl text-sm font-semibold transition-all hover:bg-emerald-50 hover:text-emerald-950 flex items-center justify-between group" id="btn-contact-numbers">
                <span class="flex items-center gap-2.5">
                    <span class="material-symbols-outlined text-base text-emerald-600">call</span>
                    <span>Contact Numbers</span>
                </span>
                <span class="material-symbols-outlined text-lg opacity-0 group-hover:opacity-100 transition-opacity">chevron_right</span>
            </button>
            <button onclick="selectPage('contact-numbers')" class="sidebar-item w-full text-left px-4 py-3 rounded-xl text-sm font-medium transition-all hover:bg-gray-100 flex items-center justify-between group hidden" id="btn-contact">
                Contact
                <span class="material-symbols-outlined text-lg opacity-0 group-hover:opacity-100 transition-opacity">chevron_right</span>
            </button>
            
            <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest pt-6 mb-4">Service Details</p>
            <button onclick="selectPage('service-seo')" class="sidebar-item w-full text-left px-4 py-3 rounded-xl text-xs font-medium transition-all hover:bg-gray-100" id="btn-service-seo">SEO Architecture</button>
            <button onclick="selectPage('service-social')" class="sidebar-item w-full text-left px-4 py-3 rounded-xl text-xs font-medium transition-all hover:bg-gray-100" id="btn-service-social">Social Ecosystems</button>
            <button onclick="selectPage('service-web')" class="sidebar-item w-full text-left px-4 py-3 rounded-xl text-xs font-medium transition-all hover:bg-gray-100" id="btn-service-web">Web Engineering</button>
            <button onclick="selectPage('service-ads')" class="sidebar-item w-full text-left px-4 py-3 rounded-xl text-xs font-medium transition-all hover:bg-gray-100" id="btn-service-ads">Paid Ads</button>
            <button onclick="selectPage('service-design')" class="sidebar-item w-full text-left px-4 py-3 rounded-xl text-xs font-medium transition-all hover:bg-gray-100" id="btn-service-design">Design & Identity</button>
            <button onclick="selectPage('service-video')" class="sidebar-item w-full text-left px-4 py-3 rounded-xl text-xs font-medium transition-all hover:bg-gray-100" id="btn-service-video">Video Production</button>
        </nav>
        
        <div class="pt-8 border-t border-black/5 mt-auto">
            <div class="flex items-center gap-3 mb-6">
                <div class="w-10 h-10 rounded-full bg-black text-white flex items-center justify-center font-bold">
                    <%= (locals.user && user.displayName) ? user.displayName.charAt(0) : 'A' %>
                </div>
                <div>
                    <p class="text-sm font-bold truncate max-w-[140px]"><%= (locals.user && user.displayName) ? user.displayName : 'Admin' %></p>
                    <p class="text-[10px] text-gray-400 uppercase tracking-widest">Administrator</p>
                </div>
            </div>
            <a href="/logout" class="flex items-center gap-2 text-xs font-bold text-red-500 hover:opacity-70 transition-opacity">
                <span class="material-symbols-outlined text-lg">logout</span>
                SIGN OUT
            </a>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-grow p-12 overflow-y-auto">
        <header class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-12">
            <div>
                <h2 id="currentPageTitle" class="text-4xl font-black uppercase tracking-tighter">SERVICES PAGE</h2>
                <p id="currentPageSubtitle" class="text-gray-500 text-sm mt-1">Manage content and service cards for this page.</p>
            </div>
            <div class="flex items-center gap-3">
                <button onclick="saveAllContactNumbers()" id="saveAllContactsBtn" class="hidden flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white px-6 py-3 rounded-full text-xs font-black uppercase tracking-widest hover:scale-105 active:scale-95 transition-all shadow-lg shadow-emerald-600/20">
                    <span class="material-symbols-outlined text-lg">done_all</span>
                    SAVE ALL NUMBERS
                </button>
                <button onclick="openArticleModal()" id="addSectionBtn" class="hidden flex items-center gap-2 bg-black text-white px-6 py-3 rounded-full text-sm font-bold hover:scale-105 transition-all">
                    <span class="material-symbols-outlined">add</span>
                    PUBLISH ARTICLE
                </button>
            </div>
        </header>

        <!-- Content Grid -->
        <div id="contentGrid" class="grid grid-cols-1 gap-6">
            <!-- Fields will be loaded here -->
            <div class="animate-pulse flex flex-col gap-4">
                <div class="h-12 bg-gray-200 rounded-xl w-1/4"></div>
                <div class="h-32 bg-gray-200 rounded-xl"></div>
            </div>
        </div>
    </main>

    <!-- Edit Modal (Simplified for inline editing) -->
    <div id="toast" class="fixed bottom-8 right-8 bg-black text-white px-6 py-4 rounded-2xl shadow-2xl translate-y-20 opacity-0 transition-all duration-500 flex items-center gap-3 z-50">
        <span class="material-symbols-outlined text-green-400">check_circle</span>
        <span id="toastMessage">Changes saved successfully</span>
    </div>

    <!-- Article Publish Modal -->
    <div id="articleModal" class="fixed inset-0 bg-black/40 backdrop-blur-md z-50 hidden items-center justify-center p-4">
        <div class="bg-gray-100 w-full rounded-[24px] p-6 md:p-8 relative max-h-[90vh] overflow-y-auto" style="max-width: 900px;">
            <button onclick="closeArticleModal()" class="absolute top-4 right-4 md:top-6 md:right-6 text-gray-400 hover:text-black">
                <span class="material-symbols-outlined">close</span>
            </button>
            <h2 id="articleModalTitle" class="text-xl md:text-2xl font-black uppercase tracking-tighter mb-4 md:mb-6">Publish Article</h2>
            <form id="newArticleForm" onsubmit="publishArticle(event)" class="space-y-3 md:space-y-4">
                <div>
                    <label class="text-[10px] md:text-xs font-bold text-gray-400 uppercase tracking-widest block mb-1 md:mb-2">Category</label>
                    <select id="art-category" required class="w-full bg-transparent border border-black/5 rounded-lg md:rounded-xl p-3 md:p-4 text-sm md:text-base focus:outline-none focus:border-black/20">
                        <option value="strategy">STRATEGY</option>
                        <option value="design">DESIGN</option>
                        <option value="technology">TECHNOLOGY</option>
                        <option value="case-studies">CASE STUDIES</option>
                    </select>
                </div>
                <div>
                    <label class="text-[10px] md:text-xs font-bold text-gray-400 uppercase tracking-widest block mb-1 md:mb-2">Image URL</label>
                    <input type="text" id="art-img" required class="w-full bg-transparent border border-black/5 rounded-lg md:rounded-xl p-3 md:p-4 text-sm md:text-base focus:outline-none focus:border-black/20" placeholder="https://...">
                </div>
                <div>
                    <label class="text-[10px] md:text-xs font-bold text-gray-400 uppercase tracking-widest block mb-1 md:mb-2">Title</label>
                    <input type="text" id="art-title" required class="w-full bg-transparent border border-black/5 rounded-lg md:rounded-xl p-3 md:p-4 text-sm md:text-base focus:outline-none focus:border-black/20" placeholder="Article title">
                </div>
                <div>
                    <label class="text-[10px] md:text-xs font-bold text-gray-400 uppercase tracking-widest block mb-1 md:mb-2">Summary</label>
                    <textarea id="art-summary" required class="w-full bg-transparent border border-black/5 rounded-lg md:rounded-xl p-3 md:p-4 text-sm md:text-base focus:outline-none focus:border-black/20 min-h-[60px]" placeholder="Short description..."></textarea>
                </div>
                <div>
                    <label class="text-[10px] md:text-xs font-bold text-gray-400 uppercase tracking-widest block mb-1 md:mb-2">Detailed Description</label>
                    <textarea id="art-description" required class="w-full bg-transparent border border-black/5 rounded-lg md:rounded-xl p-3 md:p-4 text-sm md:text-base focus:outline-none focus:border-black/20 min-h-[100px] md:min-h-[120px]" placeholder="Full article content..."></textarea>
                    
                    <!-- Internal Linking Helper UI -->
                    <div class="mt-2 border border-black/5 rounded-lg md:rounded-xl p-3 md:p-4 bg-white/50 backdrop-blur-sm">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <span class="material-symbols-outlined text-gray-400 text-base md:text-lg">link</span>
                                <span class="text-[10px] md:text-xs font-bold text-gray-500 uppercase tracking-wider">Internal Linking Helper</span>
                            </div>
                            <button type="button" onclick="scanInternalLinks()" class="bg-black text-white hover:bg-black/90 text-[10px] md:text-xs font-bold uppercase tracking-wider px-3 py-1.5 rounded-lg transition-all active:scale-95">Scan Text</button>
                        </div>
                        <div id="linking-suggestions-container" class="mt-3 hidden border-t border-black/5 pt-3">
                            <p id="suggestions-header-text" class="text-[10px] md:text-xs text-gray-400 font-bold mb-2 uppercase tracking-wider">Suggested Links</p>
                            <div id="linking-suggestions-list" class="flex flex-wrap gap-2">
                                <!-- Dynamic chips will be injected here -->
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- SEO Section -->
                <div class="border-t border-black/5 pt-6 mt-6">
                    <h3 class="text-xs font-black uppercase tracking-[0.2em] text-gray-400 mb-4">SEO Optimization (Optional)</h3>
                    <div class="space-y-4">
                        <div>
                            <label class="text-[10px] md:text-xs font-bold text-gray-400 uppercase tracking-widest block mb-1 md:mb-2">Meta Title</label>
                            <input type="text" id="art-meta-title" class="w-full bg-transparent border border-black/5 rounded-lg md:rounded-xl p-3 md:p-4 text-sm md:text-base focus:outline-none focus:border-black/20" placeholder="Custom page title for search engine results">
                        </div>
                        <div>
                            <label class="text-[10px] md:text-xs font-bold text-gray-400 uppercase tracking-widest block mb-1 md:mb-2">Meta Description</label>
                            <textarea id="art-meta-description" class="w-full bg-transparent border border-black/5 rounded-lg md:rounded-xl p-3 md:p-4 text-sm md:text-base focus:outline-none focus:border-black/20 min-h-[60px]" placeholder="Custom meta description for search snippets"></textarea>
                        </div>
                        <div>
                            <label class="text-[10px] md:text-xs font-bold text-gray-400 uppercase tracking-widest block mb-1 md:mb-2">Focus Keyword</label>
                            <input type="text" id="art-focus-keyword" class="w-full bg-transparent border border-black/5 rounded-lg md:rounded-xl p-3 md:p-4 text-sm md:text-base focus:outline-none focus:border-black/20" placeholder="Target keyword (e.g. digital marketing agency)">
                        </div>
                    </div>
                </div>

                <button type="submit" id="btnPublishArticle" class="w-full bg-black text-white font-bold py-3 md:py-4 rounded-lg md:rounded-xl hover:scale-[1.02] transition-transform text-sm md:text-base tracking-widest mt-2 md:mt-4">PUBLISH</button>
            </form>
        </div>
    </div>

    <script>
        let currentPage = 'services';
        let pageContents = {};
        let loadedArticles = [];
        let editingArticleId = null;

        // Define the "Premium Schema" - Every field on every page is mapped here
        const pageSchema = {
            'services': [
                { section: 'Hero Section', key: 'services-label', label: 'Page Subtitle', type: 'text', limit: 30 },
                { section: 'Hero Section', key: 'services-headline', label: 'Main Headline', type: 'text', limit: 40 },
                { section: 'Hero Section', key: 'services-subtext', label: 'Hero Subtext', type: 'textarea', limit: 250 },
                
                { section: 'Service Cards', key: 'services-card-seo-title', label: 'Card 1: SEO Architecture (Title)', type: 'text', limit: 25 },
                { section: 'Service Cards', key: 'services-card-seo-desc', label: 'Card 1: Description', type: 'textarea', limit: 120 },
                
                { section: 'Service Cards', key: 'services-card-social-title', label: 'Card 2: Social Ecosystems (Title)', type: 'text', limit: 25 },
                { section: 'Service Cards', key: 'services-card-social-desc', label: 'Card 2: Description', type: 'textarea', limit: 120 },
                
                { section: 'Service Cards', key: 'services-card-web-title', label: 'Card 3: Web Engineering (Title)', type: 'text', limit: 25 },
                { section: 'Service Cards', key: 'services-card-web-desc', label: 'Card 3: Description', type: 'textarea', limit: 120 },
                
