        async function selectPage(page) {
            currentPage = page;
            
            // Update UI
            document.querySelectorAll('.sidebar-item').forEach(el => el.classList.remove('active'));
            const btn = document.getElementById('btn-' + page) || (page === 'contact' ? document.getElementById('btn-contact-numbers') : null);
            if (btn) btn.classList.add('active');
            
            const titleEl = document.getElementById('currentPageTitle');
            const subEl = document.getElementById('currentPageSubtitle');
            const saveAllContactsBtn = document.getElementById('saveAllContactsBtn');
            const addSectionBtn = document.getElementById('addSectionBtn');

            if (page === 'contact-numbers' || page === 'contact') {
                titleEl.innerText = 'CONTACT NUMBERS';
                if (subEl) subEl.innerText = 'Manage all telephone numbers, WhatsApp, and email channels with live synchronization across the website.';
                if (saveAllContactsBtn) saveAllContactsBtn.classList.remove('hidden');
                if (addSectionBtn) addSectionBtn.classList.add('hidden');
            } else if (page === 'blog') {
                titleEl.innerText = 'BLOG / EDITORIAL';
                if (subEl) subEl.innerText = 'Manage blog content and publish articles.';
                if (saveAllContactsBtn) saveAllContactsBtn.classList.add('hidden');
                if (addSectionBtn) addSectionBtn.classList.remove('hidden');
            } else {
                titleEl.innerText = page.replace('-', ' ').toUpperCase() + ' PAGE';
                if (subEl) subEl.innerText = 'Manage content and service cards for this page.';
                if (saveAllContactsBtn) saveAllContactsBtn.classList.add('hidden');
                if (addSectionBtn) addSectionBtn.classList.add('hidden');
            }
            
            loadContent();
        }

