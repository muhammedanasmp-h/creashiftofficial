Options -Indexes

RewriteEngine On

# Explicit internal rewrite for services to serve services.html directly without redirect
RewriteRule ^services/?$ services.html [L]

# Serve existing physical files or directories directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Clean URLs for root pages (/about -> about.html, /blog -> blog.html, /contact -> contact.html, /service-seo -> service-seo.html)
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^/]+)/?$ $1.html [L]
