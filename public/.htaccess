Options -Indexes

RewriteEngine On

# Explicit rewrites for clean /services/ sub-pages (100% static & bug-free)
RewriteRule ^services/seo-services-kerala/?$ services/seo-services-kerala.html [L]
RewriteRule ^services/google-ads-management/?$ services/google-ads-management.html [L]
RewriteRule ^services/social-media-marketing/?$ services/social-media-marketing.html [L]
RewriteRule ^services/web-development-company/?$ services/web-development-company.html [L]
RewriteRule ^services/graphic-design-branding/?$ services/graphic-design-branding.html [L]
RewriteRule ^services/video-production-services/?$ services/video-production-services.html [L]

# Explicit rewrite for main /services page
RewriteRule ^services/?$ services/index.html [L]

# Serve existing physical files or directories directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Clean URLs for root HTML files (/about -> about.html, /blog -> blog.html, /contact -> contact.html)
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^/]+)/?$ $1.html [L]

# Browser Caching & Performance Optimizations
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # CSS and JavaScript
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"

    # Web Fonts
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"

    # Images & Favicons
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2|woff|ttf|webp|png|jpg|jpeg|gif|svg|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
