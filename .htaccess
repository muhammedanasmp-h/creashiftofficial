Options -Indexes

RewriteEngine On

# 1. Serve existing physical files or directories directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 2. Sub-services rewrite: /services/slug -> /service-pages/slug.html
RewriteCond %{DOCUMENT_ROOT}/service-pages/$1.html -f [OR]
RewriteCond %{DOCUMENT_ROOT}/public/service-pages/$1.html -f
RewriteRule ^services/([^/]+)/?$ service-pages/$1.html [L]

# 3. Clean URLs for root pages (/services -> services.html, /about -> about.html, /blog -> blog.html, /contact -> contact.html)
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^/]+)/?$ $1.html [L]
