Options -Indexes

RewriteEngine On

# Serve existing physical files or directories directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Clean URLs for root HTML files (/about -> about.html, /blog -> blog.html, /contact -> contact.html, /services -> services.html, /service-seo -> service-seo.html)
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^/]+)/?$ $1.html [L]
